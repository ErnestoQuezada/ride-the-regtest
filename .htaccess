Options -Indexes
DirectoryIndex index.php

# Defense in depth in addition to the .htaccess files inside config/ and data/.
<IfModule mod_alias.c>
    RedirectMatch 403 ^(?:data|config)(?:/|$)
</IfModule>

# Never serve executables, batch files, logs, wallet databases, or config files.
<FilesMatch "\.(?:log|bat|exe|conf|out|lock|dat|sqlite3?|tmp)$">
    Require all denied
</FilesMatch>

# These PHP files must be included/executed locally, not browsed directly.
<Files "rpc.php">
    Require all denied
</Files>

<Files "setup.php">
    Require all denied
</Files>